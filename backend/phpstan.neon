includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app

    # Level awal yang tetap ketat: error baru langsung terlihat di CI,
    # noise yang sudah ada dibekukan lewat phpstan-baseline.neon.
    level: 6

    tmpDir: storage/framework/phpstan